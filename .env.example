# =============================================================================
# sms2mqtt — .env.example
# Copy to .env and fill in values. Used by docker-compose*.yml.
# =============================================================================

# -----------------------------------------------------------------------------
# Project (Compose stack names)
# -----------------------------------------------------------------------------
# Keep bridge and persistence names different so starting persistence does not
# stop the bridge when using the same project.
SMS2MQTT_BRIDGE=sms2mqtt
SMS2MQTT_PERSISTENCE=sms2mqtt-persistence

# -----------------------------------------------------------------------------
# Main bridge (sms2mqtt) — compose.yml
# Device and MQTT connection for the GSM modem bridge.
# -----------------------------------------------------------------------------
# Host path to modem device (must be mounted in compose or passed at run).
DEVICE=/dev/mobile
# SIM PIN if required (leave empty if no PIN).
# PIN=

# MQTT broker (same broker persistence subscribes to).
PREFIX=sms2mqtt
HOST=localhost
PORT=1883
CLIENTID=sms2mqtt
# USER=
# PASSWORD=
USETLS=false
LOG_LEVEL=INFO

# Optional bridge tuning (see docs/configuration.md).
# MOREINFO=
# HEARTBEAT=
# GAMMUOPTION=
# SMS_MAX_TEXT_LENGTH=
# DEVMODE=0

# -----------------------------------------------------------------------------
# Production image (compose.production.yml)
# -----------------------------------------------------------------------------
# DOCKER_REGISTRY=ghcr.io
# DOCKER_IMAGE=your-org/sms2mqtt
# VERSION=latest

# -----------------------------------------------------------------------------
# Optional persistence stack (docker-compose.persistence.yml)
# Postgres + sms2mqtt-persistence (MQTT → DB, optional REST API and FCM push).
# -----------------------------------------------------------------------------

# --- Postgres (service: postgres) ---
# Database password (same user/db name are fixed in compose).
PGPASSWORD=sms2mqtt
# Host port for Postgres (e.g. psql -h localhost -p 5432). Default 5432.
PGPORT_HOST=5432
# Override Postgres image if needed (e.g. postgres:16-alpine or mirror).
# POSTGRES_IMAGE=postgres:17-alpine

# --- MQTT (service: sms2mqtt-persistence) — same broker as main bridge ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_PREFIX=sms2mqtt
# MQTT_USER=
# MQTT_PASSWORD=
MQTT_USETLS=false

# --- REST API and FCM push (service: sms2mqtt-persistence) ---
# If set (e.g. 8080), enables HTTP API (GET /sms, POST/DELETE /fcm-token) and Firebase Auth.
# Leave empty to run persistence only (no API, no push). Required for push.
API_PORT=8080
# Host port where API is published (default 8080). Compose maps this to container port 8080.
API_PORT_HOST=8080

# Path *inside container* to Firebase service account JSON. Compose mounts the file here.
# Default in compose: /app/firebase-credentials.json. Usually you don't change this.
# FIREBASE_CREDENTIALS=/app/firebase-credentials.json

# Path *on host* to your Firebase service account JSON file. Compose mounts this file
# into the container. Required when API_PORT is set. Example: ./firebase-credentials.json
# or full path: /home/user/secrets/firebase-sa.json
FIREBASE_CREDENTIALS_FILE=./firebase-credentials.json

# Send FCM push on new SMS (received). Default true when API is enabled.
PUSH_ENABLED=true
# Send FCM push on sent SMS too. Default false.
PUSH_ON_SENT=false

# --- Persistence logging ---
# LOG_LEVEL=INFO
